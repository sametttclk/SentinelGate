{
  "info": {
    "name": "SentinelGate - Kritik Altyapı İzleme API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt_token", "value": "" }
  ],
  "item": [
    {
      "name": "UC-01 Login (Admin)",
      "event": [{
        "listen": "test",
        "script": { "exec": ["const res = pm.response.json(); if(res.token){ pm.collectionVariables.set('jwt_token', res.token); }"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}" },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "UC-02 Telemetri Listele (GET)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": "{{baseUrl}}/api/v1/telemetry"
      }
    },
    {
      "name": "UC-03 Telemetri Gönder (POST)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"sensorId\": \"RADAR-UNIT-ALPHA\",\n  \"facilityZone\": \"SECTOR-7G\",\n  \"metricType\": \"CORE_TEMP\",\n  \"metricValue\": 88.4,\n  \"unit\": \"CELSIUS\",\n  \"severity\": \"CRITICAL\"\n}" },
        "url": "{{baseUrl}}/api/v1/telemetry"
      }
    },
    {
      "name": "UC-04 Audit Logları İncele (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
        "url": "{{baseUrl}}/api/v1/audit-logs"
      }
    }
  ]
}
